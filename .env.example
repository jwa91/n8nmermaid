# Currently not used by the script
ENVIRONMENT=development

# Set the logging level for application logs.
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO if not set.
N8NMERMAID_LOG_LEVEL=INFO

# Set the logging target.
# - FILE: Log to 'conversion.log' (level determined by N8NMERMAID_LOG_LEVEL)
#         AND log WARNING/ERROR/CRITICAL to console (stderr).
# - CONSOLE: Log ONLY to console (stderr) (level determined by N8NMERMAID_LOG_LEVEL).
# Production runtime defaults to CONSOLE in /etc/n8nmermaid-api/env.
# Application code defaults to FILE if LOGGING_TARGET is not set.
LOGGING_TARGET=CONSOLE
